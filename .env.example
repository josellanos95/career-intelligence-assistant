# LLM provider used for chat/reasoning. One of: "claude", "openai"
# Defaults to "openai" so the app works with a single API key out of the box
# (OpenAI is already required for embeddings). Set to "claude" and provide
# ANTHROPIC_API_KEY to use Claude instead -- swapping providers requires no
# code changes, only this value (see app/infra/llm/factory.py).
LLM_PROVIDER=openai

# Anthropic (used for chat when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI (used for embeddings always, and for chat when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector store (custom numpy-based store, see app/infra/vectorstore/numpy_store.py)
VECTOR_STORE_DIR=./data/vector_store

# App
LOG_LEVEL=INFO
MAX_CONTEXT_CHUNKS=8
